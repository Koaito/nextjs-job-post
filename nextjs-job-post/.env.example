# Mẫu biến môi trường. Sao chép thành .env.local (KHÔNG commit .env.local).
# Tất cả chỉ dùng phía server; KHÔNG đặt tiền tố NEXT_PUBLIC_ cho khoá/URL backend.

# URL backend FastAPI (Render)
CRAWLER_API_URL=https://your-backend.onrender.com
# Phải khớp API_KEY của backend. Bí mật, chỉ phía server.
CRAWLER_API_KEY=
# Origin công khai của chính app này, dùng cho kiểm tra CSRF (lib/verify-origin.ts). Vd http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
